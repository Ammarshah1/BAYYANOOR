{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "api/health.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}